---
import BaseLayout from '../layouts/BaseLayout.astro';
import { journeyGroups } from '../data/journey.js';
---

<BaseLayout title="Journey | Manasvini Kandikonda" description="A chronological account of projects, research, leadership, and what I’m learning." active="journey">
  <main id="main-content" class="journey-page">
    <div class="page-shell journey-intro">
      <!-- <div class="eyebrow">A work in progress</div> -->
      <h1 class="page-title">Journey</h1>
      <p class="lede">How it all played out</p>
    </div>

    <div class="page-shell journey-timeline">
      {journeyGroups.map((group, groupIndex) => (
        <section class="journey-group" aria-labelledby={`journey-year-${groupIndex}`}>
          <h2 id={`journey-year-${groupIndex}`} class="journey-year">{group.period}</h2>
          <ol class="journey-entries">
            {group.entries.map((entry, entryIndex) => (
              <li class="journey-entry">
                {entry.section && group.entries[entryIndex - 1]?.section !== entry.section && <h3 class="journey-section-title">{entry.section}</h3>}
                <p class="journey-type">{entry.type}</p>
                {entry.section ? <h4>{entry.title}</h4> : <h3>{entry.title}</h3>}
                {entry.date && <p class="journey-date">{entry.date}</p>}
                {entry.description && <p class="journey-description">{entry.description}</p>}
                {entry.links?.length > 0 && (
                  <ul class="journey-links">
                    {entry.links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
