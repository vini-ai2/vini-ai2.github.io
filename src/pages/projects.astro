---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentProjects, projects, projectCategories, projectLanguages, repositoryUrl } from '../data/projects.js';
---

<BaseLayout
  title="Projects | Manasvini Kandikonda"
  description=" Current projects and selected historical projects by Manasvini Kandikonda."
  active="projects"
>
  <main id="main-content" class="projects-page">
    <div class="page-hero">
      <div class="eyebrow">Projects</div>
      <h4>All the projects that came out of curiousity, or just real hard academics.</h1>
      <p>Current, Previous and open source projects</p>
    </div>

    <section class="current-projects page-shell" aria-labelledby="current-projects-title">
      <h2 id="current-projects-title" class="section-title">Current projects</h2>
      <div class="current-project-list">
        {currentProjects.map((project) => (
          <article class="current-project">
            <div class="current-project-heading">
              <h3>{project.title}</h3>
              <span class="project-status">{project.status}</span>
            </div>
            <p>{project.description}</p>
            {project.subprojects.length > 0 && (
              <ul class="subproject-list">
                {project.subprojects.map((subproject) => (
                  <li><strong>{subproject.title}</strong><span>{subproject.description}</span></li>
                ))}
              </ul>
            )}
            {project.repo && <a class="text-link" href={repositoryUrl(project)} target="_blank" rel="noopener noreferrer">GitHub repository <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="historical-projects" aria-labelledby="historical-projects-title">
      <div class="page-shell historical-heading">
        <h2 id="historical-projects-title" class="section-title">Projects up till now</h2>
        <p class="lede">Filter by a topic, a programming language, or both.</p>
      </div>
      <div class="catalogue-controls" aria-label="Historical project filters">
        <label class="project-search-label" for="project-search">Search projects</label>
        <input id="project-search" class="project-search" type="search" autocomplete="off" />
        <fieldset class="filter-set">
          <legend>Topic</legend>
          <div class="filters" id="topic-filters" aria-label="Filter by topic"></div>
        </fieldset>
        <fieldset class="filter-set">
          <legend>Programming language</legend>
          <div class="filters" id="language-filters" aria-label="Filter by programming language"></div>
        </fieldset>
        <p class="catalogue-count" id="catalogue-count" aria-live="polite"></p>
      </div>
      <div class="card-grid" id="project-grid" aria-live="polite"></div>
    </section>

    <section class="open-source-note page-shell" aria-labelledby="open-source-title">
      <h2 id="open-source-title" class="section-title">Open source contributions</h2>
      <p>Coming up.</p>
      <a class="text-link" href="https://github.com/vini-ai2" target="_blank" rel="noopener noreferrer">Browse all public repositories on GitHub <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<script>
  import { projects, projectCategories, projectLanguages, repositoryUrl } from '../data/projects.js';

  const grid = document.getElementById('project-grid')!;
  const topicFilters = document.getElementById('topic-filters')!;
  const languageFilters = document.getElementById('language-filters')!;
  const searchInput = document.getElementById('project-search') as HTMLInputElement;
  const count = document.getElementById('catalogue-count')!;
  let activeTopic = 'all';
  let activeLanguage = 'all';

  const htmlEscapes: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => htmlEscapes[character]);

  function renderFilterGroup(container: HTMLElement, values: string[], active: string, label: string, select: (value: string) => void) {
    const options = ['all', ...values];
    container.innerHTML = options.map((value) => {
      const selected = value === active;
      const text = value === 'all' ? `All ${label}` : value;
      return `<button type="button" class="filter-pill${selected ? ' active' : ''}" data-filter="${escapeHtml(value)}" aria-pressed="${selected}">${escapeHtml(text)}</button>`;
    }).join('');
    container.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => select(button.dataset.filter || 'all'));
    });
  }

  function renderFilters() {
    renderFilterGroup(topicFilters, projectCategories, activeTopic, 'topics', (value) => {
      activeTopic = value;
      renderFilters();
      renderGrid();
    });
    renderFilterGroup(languageFilters, projectLanguages, activeLanguage, 'languages', (value) => {
      activeLanguage = value;
      renderFilters();
      renderGrid();
    });
  }

  function renderGrid() {
    const query = searchInput.value.trim().toLowerCase();
    const visibleProjects = projects.filter((project) => {
      const topicMatch = activeTopic === 'all' || project.category === activeTopic;
      const languageMatch = activeLanguage === 'all' || (project.languages ?? []).includes(activeLanguage);
      const searchable = [project.title, project.category, project.status, project.blurb, project.description, ...project.stack, ...(project.languages ?? [])].join(' ').toLowerCase();
      return topicMatch && languageMatch && (!query || searchable.includes(query));
    });

    count.textContent = `${visibleProjects.length} ${visibleProjects.length === 1 ? 'project' : 'projects'}`;
    if (!visibleProjects.length) {
      grid.innerHTML = '<p class="empty-projects">No projects match those filters. Try a different combination.</p>';
      return;
    }

    grid.innerHTML = visibleProjects.map((project) => `
      <article class="card project-card ${project.featured ? 'featured' : ''}" data-id="${escapeHtml(project.id)}">
        <div class="project-card-meta"><span class="tag">${escapeHtml(project.category)}</span>${project.status ? `<span class="project-status">${escapeHtml(project.status)}</span>` : ''}</div>
        <h3>${escapeHtml(project.title)}</h3>
        <p>${escapeHtml(project.blurb)}</p>
        <div class="project-stack-preview">${(project.languages ?? []).map((language) => `<span class="stack-pill">${escapeHtml(language)}</span>`).join('')}</div>
        <div class="project-card-actions">
          <button class="project-details" type="button" data-details="${escapeHtml(project.id)}" aria-label="Details for ${escapeHtml(project.title)}">Details</button>
          <a class="project-repo" href="${escapeHtml(repositoryUrl(project))}" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </article>`).join('');

    grid.querySelectorAll<HTMLButtonElement>('[data-details]').forEach((button) => {
      button.addEventListener('click', () => {
        const project = projects.find((item) => item.id === button.dataset.details);
        const openPanel = (window as any).openPanel;
        if (!project || !openPanel) return;
        const stackHtml = `<div class="stack-row">${project.stack.map((technology: string) => `<span class="stack-pill">${escapeHtml(technology)}</span>`).join('')}</div>`;
        const languageHtml = (project.languages ?? []).length ? `<p class="project-panel-languages">Languages: ${(project.languages ?? []).map(escapeHtml).join(', ')}</p>` : '';
        const statusHtml = project.status ? `<p class="project-panel-status">${escapeHtml(project.status)}</p>` : '';
        const repo = repositoryUrl(project);
        openPanel(`<h1>${escapeHtml(project.title)}</h1>${statusHtml}<p>${escapeHtml(project.description)}</p>${languageHtml}${stackHtml}<div class="section"><h2>Repository</h2><a class="panel-link" href="${escapeHtml(repo)}" target="_blank" rel="noopener noreferrer">${escapeHtml(repo)}</a></div>`);
      });
    });
  }

  searchInput.addEventListener('input', renderGrid);
  renderFilters();
  renderGrid();
</script>
